{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateStorage",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws-eusc:s3:::admin-tool-demo-tfstate-*-eusc-de-east-1",
        "arn:aws-eusc:s3:::admin-tool-demo-tfstate-*-eusc-de-east-1/*"
      ]
    },
    {
      "Sid": "GithubIdentityProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:UntagOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviderTags",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": "arn:aws-eusc:iam::*:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "NamedDeploymentRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws-eusc:iam::*:role/admin-tool-demo-github-deploy"
    }
  ]
}
